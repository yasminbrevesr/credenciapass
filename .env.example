# Aplicação (Vercel/serverless): use o Supavisor transaction pooler, geralmente porta 6543.
DATABASE_URL="postgresql://USUARIO.PROJECT_REF:SENHA@REGIAO.pooler.supabase.com:6543/postgres?sslmode=require"

# Prisma CLI/migrações: use a conexão direta ou o Supavisor session pooler, geralmente porta 5432.
DIRECT_URL="postgresql://USUARIO.PROJECT_REF:SENHA@REGIAO.pooler.supabase.com:5432/postgres?sslmode=require"

# Chave usada para assinar o cookie de sessão. Gere uma chave forte em produção.
SESSION_SECRET="gere-uma-chave-aleatoria-com-32-caracteres-ou-mais"

# Opcionais: usados pelo seed para criar o primeiro administrador.
ADMIN_EMAIL="admin@credenciapass.local"
ADMIN_PASSWORD="troque-esta-senha"

# Envio de certificados por e-mail usando Resend.
RESEND_API_KEY="re_xxxxxxxxx"
EMAIL_FROM="CredenciaPass <certificados@seu-dominio.com>"
