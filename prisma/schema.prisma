// CredenciaPass — schema do banco (SQLite via driver adapter better-sqlite3).
// Para migrar para PostgreSQL depois, basta trocar o provider abaixo e o adapter em src/lib/db.ts.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

/// Operadores do sistema (ADMIN gerencia tudo; OPERADOR credencia e consulta).
model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         String   @default("OPERADOR")
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  checkins     Attendance[]
  certificates Certificate[]
}

/// Evento que será credenciado. Os dias vêm em EventDay (a presença é por dia).
model Event {
  id             String   @id @default(cuid())
  name           String
  description    String?
  location       String?
  organizer      String?
  startDate      DateTime
  endDate        DateTime
  workloadHours  Float?
  /// Lista de qualificações aceitas, em JSON: ["Participante","Professor",...]
  qualifications String   @default("[\"Participante\",\"Professor\",\"Colaborador\"]")
  /// Texto do certificado com marcadores {{nome}}, {{evento}}, {{periodo}}, etc.
  certificateText String?
  /// Presença mínima (em dias) exigida para emitir certificado. 0 = não exige.
  minAttendanceDays Int   @default(0)
  archived       Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  days         EventDay[]
  participants Participant[]

  @@index([archived, startDate])
}

/// Cada dia do evento em que há checagem de presença.
model EventDay {
  id      String   @id @default(cuid())
  eventId String
  event   Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  date    DateTime
  label   String?

  attendances Attendance[]

  @@unique([eventId, date])
  @@index([eventId])
}

/// Inscrito no evento. `code` é o conteúdo do QR Code / código de barras do crachá.
model Participant {
  id            String   @id @default(cuid())
  eventId       String
  event         Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  code          String   @unique
  name          String
  document      String
  email         String?
  phone         String?
  qualification String   @default("Participante")
  organization  String?
  position      String?
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  attendances  Attendance[]
  certificates Certificate[]

  @@unique([eventId, document])
  @@index([eventId, name])
  @@index([eventId, qualification])
}

/// Presença confirmada de um participante em um dia do evento.
model Attendance {
  id            String   @id @default(cuid())
  participantId String
  participant   Participant @relation(fields: [participantId], references: [id], onDelete: Cascade)
  eventDayId    String
  eventDay      EventDay    @relation(fields: [eventDayId], references: [id], onDelete: Cascade)
  checkedInAt   DateTime    @default(now())
  /// QRCODE | MANUAL
  method        String      @default("MANUAL")
  operatorId    String?
  operator      User?       @relation(fields: [operatorId], references: [id], onDelete: SetNull)

  @@unique([participantId, eventDayId])
  @@index([eventDayId])
}

/// Registro de emissão de certificado (permite validação pública pelo código).
model Certificate {
  id            String   @id @default(cuid())
  participantId String
  participant   Participant @relation(fields: [participantId], references: [id], onDelete: Cascade)
  code          String   @unique
  issuedAt      DateTime @default(now())
  issuedById    String?
  issuedBy      User?    @relation(fields: [issuedById], references: [id], onDelete: SetNull)

  @@unique([participantId])
}
