// CredenciaPass — schema PostgreSQL hospedado no Supabase.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// Operadores do sistema (ADMIN gerencia tudo; OPERADOR credencia e consulta).
model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         String   @default("OPERADOR")
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  checkins      Attendance[]
  certificates  Certificate[]
  eventAccesses EventAccess[]
}

/// Evento que será credenciado. Os dias vêm em EventDay (a presença é por dia).
model Event {
  id                String   @id @default(cuid())
  name              String
  description       String?
  location          String?
  organizer         String?
  startDate         DateTime
  endDate           DateTime
  workloadHours     Float?
  qualifications    String   @default("[\"Participante\",\"Professor\",\"Colaborador\"]")
  certificateText   String?
  minAttendanceDays Int      @default(0)
  archived          Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  days         EventDay[]
  participants Participant[]
  accesses     EventAccess[]

  @@index([archived, startDate])
}

/// Define a quais eventos cada operador pode acessar.
model EventAccess {
  id        String   @id @default(cuid())
  userId    String
  eventId   String
  createdAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([userId, eventId])
  @@index([eventId])
}

model EventDay {
  id      String   @id @default(cuid())
  eventId String
  event   Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  date    DateTime
  label   String?

  attendances Attendance[]

  @@unique([eventId, date])
  @@index([eventId])
}

model Participant {
  id            String   @id @default(cuid())
  eventId       String
  event         Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  code          String   @unique
  name          String
  document      String
  email         String?
  phone         String?
  qualification String   @default("Participante")
  organization  String?
  position      String?
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  attendances  Attendance[]
  certificates Certificate[]

  @@unique([eventId, document])
  @@index([eventId, name])
  @@index([eventId, qualification])
}

model Attendance {
  id            String      @id @default(cuid())
  participantId String
  participant   Participant @relation(fields: [participantId], references: [id], onDelete: Cascade)
  eventDayId    String
  eventDay      EventDay    @relation(fields: [eventDayId], references: [id], onDelete: Cascade)
  checkedInAt   DateTime    @default(now())
  method        String      @default("MANUAL")
  operatorId    String?
  operator      User?       @relation(fields: [operatorId], references: [id], onDelete: SetNull)

  @@unique([participantId, eventDayId])
  @@index([eventDayId])
}

model Certificate {
  id            String      @id @default(cuid())
  participantId String
  participant   Participant @relation(fields: [participantId], references: [id], onDelete: Cascade)
  code          String      @unique
  issuedAt      DateTime    @default(now())
  issuedById    String?
  issuedBy      User?       @relation(fields: [issuedById], references: [id], onDelete: SetNull)

  @@unique([participantId])
}
